{
  "manifest_version": 3,
  "name": "Grindset",
  "version": "1.5.0",
  "description": "Pair with the local Grindset app to track foreground website domains and apply your focus rules. Works in Chrome, Edge and Firefox-based browsers such as Zen.",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "idle",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:47831/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "Grindset - open pairing settings"
  },
  "options_page": "setup.html",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "heartbeat.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.js",
        "styles.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' http://127.0.0.1:47831"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "grindset-extension@grindset.app",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity"
        ]
      }
    }
  }
}
